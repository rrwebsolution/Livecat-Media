# Public address of the deployed site, without a trailing slash, for example https://www.example.com
# Used for the Open Graph image in index.html. Empty keeps the path relative.
VITE_SITE_URL=https://www.getlivecat.com

# Google Search Console HTML-tag verification: paste only the content="..." value here. Leave empty when the
# domain is verified with a DNS TXT record instead (recommended).
VITE_GOOGLE_SITE_VERIFICATION=
